# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string. REQUIRED in production. When unset (dev only),
# the app falls back to an embedded PGlite database in ./.pglite — that store
# does NOT persist on serverless platforms, so Vercel needs a real Postgres.
#
# Use your provider's POOLED connection string on serverless:
#   Neon      → the "-pooler" host  (recommended; also available as Vercel Postgres)
#   Supabase  → port 6543, transaction mode
# DATABASE_URL=postgres://user:password@host-pooler.neon.tech/db?sslmode=require

# Directory for the embedded PGlite database (dev only). Defaults to ".pglite".
# PGLITE_DIR=.pglite

# ── LLM summaries ─────────────────────────────────────────────────────────
# The summariser picks a provider by which key is set: DeepSeek first, then
# Anthropic, then a deterministic heuristic if neither is present.

# DeepSeek (OpenAI-compatible). Model defaults to "deepseek-chat".
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic (used only when DEEPSEEK_API_KEY is unset). Defaults to claude-opus-4-8.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Secrets ───────────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production (the app throws without it).
# Generate: openssl rand -hex 32
# SESSION_SECRET=change-me-to-a-long-random-string

# Guards the cron/worker routes. In production these routes are LOCKED unless
# this is set. Vercel Cron automatically sends it as a Bearer token, so set the
# same value here and in the Vercel project. Generate: openssl rand -hex 32
# CRON_SECRET=change-me-to-a-long-random-string
