# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string. When unset, the app falls back to an embedded
# PGlite database written to ./.pglite (no server required) — handy for local
# dev, not for production.
# DATABASE_URL=postgres://user:password@localhost:5432/pecalang

# Directory for the embedded PGlite database (only used when DATABASE_URL is
# unset). Defaults to ".pglite".
# PGLITE_DIR=.pglite

# ── LLM summaries ─────────────────────────────────────────────────────────
# Anthropic API key. When unset, change summaries fall back to a deterministic
# heuristic (diff line counts + first added line) instead of a Claude summary.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Secrets ───────────────────────────────────────────────────────────────
# Signs the session cookie. Set a long random value in production — the
# built-in dev fallback is NOT safe to ship.
# SESSION_SECRET=change-me-to-a-long-random-string

# Shared secret guarding the machine-to-machine routes (/api/cron/dispatch and
# /api/worker/check). When unset, those routes are open — fine locally, unsafe
# in production. Send it as the `x-cron-secret` header (or `Authorization:
# Bearer <secret>`) when triggering the dispatcher.
# CRON_SECRET=change-me-to-a-long-random-string
